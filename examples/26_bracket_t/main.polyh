# Example 26: T-Bracket
# A T-shaped structural bracket with a horizontal base bar and a vertical stem.
# Used for right-angle support in frames and enclosures.

define base_plate
  units mm
  cube
    width  80
    depth  6
    height 20
  end
end

define stem
  units mm
  cube
    width  6
    depth  6
    height 40
    move z 20
  end
end

assemble t_bracket
  units mm
  place base_plate at origin
  join  stem at origin
  fillet 2
end

export
  format stl
  quality medium
  file output.stl
end
