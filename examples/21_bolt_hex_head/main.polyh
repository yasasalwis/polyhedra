# 21_bolt_hex_head — Hex-head bolt: hexagonal head + cylindrical shank
# Compile: polyhedra -c main.polyh -o stl

define hex_head
  units mm
  prism
    sides  6
    radius 8
    height 6
  end
end

define shank
  units mm
  cylinder
    radius  4
    height 24
    move   z -24
  end
end

assemble bolt_hex_head
  units mm
  place hex_head at origin
  join  shank    at origin
end

export
  format stl
  quality medium
  file   bolt_hex_head.stl
end
