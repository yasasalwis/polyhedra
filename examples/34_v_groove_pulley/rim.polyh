# V-Groove Pulley - outer rim, groove, hub, and bore

define outer
  units mm
  cylinder
    radius 40
    height 20
  end
end

define groove
  units mm
  torus
    major 40
    minor 6
  end
end

define hub
  units mm
  cylinder
    radius 12
    height 24
    move z -2
  end
end

define bore
  units mm
  cylinder
    radius 6
    height 26
  end
end
