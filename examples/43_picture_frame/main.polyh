# Example 43: Picture Frame
# A rectangular picture frame with a routed back recess for a photo or artwork.
# The front face is solid; the back pocket holds the picture in place.

define frame_outer
  units mm
  cube
    width  160
    depth  120
    height 15
  end
end

define frame_cutout
  units mm
  cube
    width  140
    depth  100
    height 17
  end
end

define back_cut
  units mm
  cube
    width  130
    depth  90
    height 13
    move z 1
  end
end

assemble picture_frame
  units mm
  place frame_outer at origin
  cut   frame_cutout at origin
  cut   back_cut at origin
  fillet 3
end

export
  format stl
  quality medium
  file output.stl
end
