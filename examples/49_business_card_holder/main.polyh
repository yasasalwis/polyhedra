# Example 49: Business Card Holder
# A desk business card holder with a flat base, tall back wall, and front ledge.
# Holds a stack of standard business cards at an accessible angle.

define base
  units mm
  cube
    width  100
    depth  70
    height 4
  end
end

define back_wall
  units mm
  cube
    width  100
    depth  4
    height 40
    move z 4
    move y -33
  end
end

define front_ledge
  units mm
  cube
    width  100
    depth  10
    height 3
    move z 4
    move y 30
  end
end

assemble business_card_holder
  units mm
  place base at origin
  join  back_wall at origin
  join  front_ledge at origin
  fillet 2
end

export
  format stl
  quality medium
  file output.stl
end
