# Example 28: Mounting Plate
# A flat rectangular plate with four M3 clearance holes at the corners.
# Used for attaching electronics or panels to a frame.

define plate
  units mm
  cube
    width  80
    depth  60
    height 4
  end
end

define m3_hole
  units mm
  cylinder
    radius 1.6
    height 6
  end
end

assemble mounting_plate
  units mm
  place plate at origin
  cut   m3_hole at (-30, -20, 0)
  cut   m3_hole at (30, -20, 0)
  cut   m3_hole at (-30, 20, 0)
  cut   m3_hole at (30, 20, 0)
end

export
  format stl
  quality medium
  file output.stl
end
