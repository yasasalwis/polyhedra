# Example 33: Gear Blank
# A cylindrical gear blank with a raised hub, key slot, and central bore.
# Used as the starting stock for machining spur gear teeth.

define blank
  units mm
  cylinder
    radius 30
    height 12
  end
end

define hub
  units mm
  cylinder
    radius 10
    height 18
    move z -3
  end
end

define key_slot
  units mm
  cube
    width  4
    depth  8
    height 20
  end
end

define bore
  units mm
  cylinder
    radius 6
    height 20
  end
end

assemble gear_blank
  units mm
  place blank at origin
  join  hub at origin
  cut   bore at origin
end

export
  format stl
  quality medium
  file output.stl
end
