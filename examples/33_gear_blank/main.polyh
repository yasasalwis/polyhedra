# Example 33: Spur Gear
# A 12-tooth spur gear with a central bore and raised hub.

define gear_body
  units mm
  gear
    teeth  12
    radius 25
    tooth_height 5
    height 12
  end
end

define hub
  units mm
  cylinder
    radius 10
    height 18
    move z -3
  end
end

define bore
  units mm
  cylinder
    radius 6
    height 20
  end
end

assemble spur_gear
  units mm
  place gear_body at origin
  join  hub       at origin
  cut   bore      at origin
end

export
  format stl
  quality medium
  file output.stl
end
